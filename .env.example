# Least-privilege role created in docs/plans/02-database.md. Never the database owner.
DATABASE_URL="postgresql://dense_app:CHANGE_ME@localhost:5432/budgettracker-nextjs"

# Signs the session cookie (HS256). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it signs everyone out. Must differ from budgettracker's NEXTAUTH_SECRET.
SESSION_SECRET=""

# Comma-separated addresses permitted to sign in, whatever the password. Empty
# denies everyone, so this is never optional.
ALLOWED_EMAILS=""

# Checkout this app syncs its schema and vendored logic from.
BUDGETTRACKER_DIR="../budgettracker"
