{
  "name": "budgettrackerdense",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3200",
    "build": "prisma generate && next build",
    "start": "next start -p 3200",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsx scripts/type-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:schema": "tsx scripts/sync-schema.ts",
    "sync:vendor": "tsx scripts/sync-vendor.ts",
    "check:drift": "tsx scripts/check-drift.ts",
    "smoke:reads": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/smoke-reads.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.2",
    "next": "16.4.6",
    "prisma": "6.19.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.3.0"
}
